                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/blue_plate/blue_plate/Looks/material0> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }

    def "blue_plate" (
